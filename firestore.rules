rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function inGuild(guildId) {
      return signedIn() && userDoc().data.guildId == guildId;
    }

    match /users/{userId} {
      allow read, create, update: if signedIn() && request.auth.uid == userId;
    }

    match /guilds/{guildId} {
      allow create: if signedIn();
      allow read: if signedIn();
      allow update: if inGuild(guildId);
      allow delete: if false;

      match /characters/{characterId} {
        allow read, create, update, delete: if inGuild(guildId);
      }

      match /missions/{missionId} {
        allow read, create, update, delete: if inGuild(guildId);
      }

      match /items/{itemId} {
        allow read, create, update, delete: if inGuild(guildId);
      }

      match /mission_logs/{logId} {
        allow read, create: if inGuild(guildId);
        allow update, delete: if false;
      }

      match /usage_logs/{logId} {
        allow read, create: if inGuild(guildId);
        allow update, delete: if false;
      }

      match /grade_logs/{logId} {
        allow read, create: if inGuild(guildId);
        allow update, delete: if false;
      }

      match /transfer_logs/{logId} {
        allow read, create: if inGuild(guildId);
        allow update, delete: if false;
      }
    }
  }
}
